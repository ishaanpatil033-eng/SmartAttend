# ===================================================================
# SmartAttend — Production Environment Variables Template
# Copy to .env and configure with production credentials before deployment
# ===================================================================

# -------------------------------------------------------------------
# Database Configuration (MySQL 8)
# -------------------------------------------------------------------
DB_NAME=smartattend
DB_USER=smartattend_app
DB_PASSWORD=ChangeThisToAStrongProductionPassword123!
DB_ROOT_PASSWORD=ChangeThisToAStrongRootPassword456!

# -------------------------------------------------------------------
# Spring Boot Production Datasource (Mapped to backend container)
# -------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://database:3306/smartattend?createDatabaseIfNotExist=false&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=smartattend_app
SPRING_DATASOURCE_PASSWORD=ChangeThisToAStrongProductionPassword123!

# -------------------------------------------------------------------
# Frontend & Network Security Configuration
# -------------------------------------------------------------------
HTTP_PORT=80
FRONTEND_ORIGIN=https://smartattend.institution.edu
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# -------------------------------------------------------------------
# Campus Geofence GPS Coordinates (Institutional Classroom Center)
# -------------------------------------------------------------------
ATTENDANCE_LATITUDE=19.0760
ATTENDANCE_LONGITUDE=72.8777
ATTENDANCE_RADIUS_METERS=100.0
ATTENDANCE_MAX_ACCURACY=50.0

# -------------------------------------------------------------------
# Moodle LMS Integration (Optional)
# Leave empty if running standalone without active Moodle token.
# - For local host OS / XAMPP Moodle: http://host.docker.internal/moodle
# - For institutional / external server: https://moodle.institution.edu
# -------------------------------------------------------------------
MOODLE_BASE_URL=http://host.docker.internal/moodle
MOODLE_TOKEN=
